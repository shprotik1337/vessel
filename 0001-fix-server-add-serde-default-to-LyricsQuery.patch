+++ b/apps/vessel-server/src/main.rs
@@ -748,7 +748,8 @@ fn is_allowed_image_host(host: &str) -> bool {
         || host.ends_with(".yandex.ru") || host == "yandex.ru"
 }
 
-#[derive(Deserialize)]
